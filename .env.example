# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# NEXT_PUBLIC_* values are safe to ship to the browser — Supabase's anon key is
# meant to be public and is constrained by Row Level Security policies, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ — these must not reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
GOOGLE_PLACES_API_KEY=

# PostHog (Project Settings -> Project API Key in the PostHog dashboard).
# Like the Supabase anon key above, this one's meant to be public — it only
# lets a browser send events in, nothing it can read back out. Optional:
# leave blank and src/lib/analytics.ts just no-ops instead of tracking.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
